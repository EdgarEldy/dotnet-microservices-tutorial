{
  "consumer": {
    "name": "order-api"
  },
  "interactions": [
    {
      "description": "a request for a customer that does not exist",
      "pending": false,
      "providerStates": [
        {
          "name": "no customer with id 999"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer eyJhbGciOiJIUzI1NiJ9.contract-test.signature"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/Customers/999"
      },
      "response": {
        "headers": {
          "Content-Type": [
            "application/problem+json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/problem\\+json(;\\s?charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 404
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for the caller's own customer profile",
      "pending": false,
      "providerStates": [
        {
          "name": "a customer with id 1 exists"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer eyJhbGciOiJIUzI1NiJ9.contract-test.signature"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/Customers/1"
      },
      "response": {
        "body": {
          "content": {
            "address": "1 Analytical Engine Street",
            "email": "ada@example.com",
            "firstName": "Ada",
            "id": 1,
            "lastName": "Lovelace",
            "telephone": "+33600000000",
            "userId": 42
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.address": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.firstName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lastName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.telephone": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.userId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json(;\\s?charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "customer-api"
  }
}