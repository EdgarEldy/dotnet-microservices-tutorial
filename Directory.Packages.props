<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <DotnetPackagesVersion>10.0.12</DotnetPackagesVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version together with the .NET runtime -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(DotnetPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(DotnetPackagesVersion)" />
    <!-- Miscellaneous -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <!-- Testing -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
  </ItemGroup>

</Project>
